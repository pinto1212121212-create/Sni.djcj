{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "name":      { ".validate": "newData.isString() && newData.val().length <= 200" },
        "email":     { ".validate": "newData.isString() && newData.val().length <= 320" },
        "createdAt": { ".validate": "newData.isNumber() || newData.isString()" },

        "panel": {
          "updatedAt": { ".validate": "newData.isNumber()" },

          "sites": {
            "$index": {
              "id":     { ".validate": "newData.isString() && newData.val().length <= 100" },
              "name":   { ".validate": "newData.isString() && newData.val().length <= 200" },
              "repo":   { ".validate": "newData.isString() && newData.val().length <= 200" },
              "owner":  { ".validate": "newData.isString() && newData.val().length <= 200" },
              "$other": { ".validate": false }
            }
          },

          "deletedIds": {
            "$index": { ".validate": "newData.isString() && newData.val().length <= 100" }
          },

          "$other": { ".validate": false }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
